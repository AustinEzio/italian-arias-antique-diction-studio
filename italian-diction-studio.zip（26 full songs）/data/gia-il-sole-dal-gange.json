  "composer": {
    "name": "Alessandro Scarlatti",
    "life": "1660–1725"
  },
  "source": "出自歌剧《L'honestà negli amori》（罗马，1680）；《26 Italian Songs and Arias》第6首；歌词为17世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "（原谱 A 大调）",
  "tempo": "明亮、流动（Allegro 性格）",
  "structure": "通谱（两个诗节，无再现）",
  "intro": "斯卡拉蒂（Alessandro Scarlatti）1680 年创作此曲时年仅 19 岁，已任瑞典克里斯蒂娜女王（居于罗马）的音乐总监。本曲出自他的第二部歌剧《爱情中的诚实》，由剧中侍童萨尔迪诺（Saldino）演唱：他独自在舞台上欣赏日出——\"恒河上升起的太阳更明亮地闪耀，擦干哭泣黎明的每一滴泪珠；用金色的光芒为每株草茎镶上宝石，把天上的星辰描绘在草地上。\"（\"恒河\"只是指东方的修辞说法，场景在北非阿尔及尔。）原谱 A 大调，太阳在音阶上冉冉升起是旋律的象征手法；巴黎奥蒂版为打破长音阶改用重复词句，反而破坏了这层意象。",
  "lyrics": [
    {
      "section": "A",
      "it": "Già il sole dal Gange",
      "zh": "恒河上升起的太阳",
      "words": [
        { "it": "Già", "ipa": "dʒa", "zh": "已经" },
        { "it": "il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "sole", "ipa": "ˈsɔː.le", "zh": "太阳" },
        { "it": "dal", "ipa": "dal", "zh": "从……来（da+il）" },
        { "it": "Gange", "ipa": "ˈɡan.dʒe", "zh": "恒河" }
      ],
      "notes": "sole 的 o 开口 [ɔ]——本曲第一个也是最重要的开闭口敏感词。"
    },
    {
      "section": "A",
      "it": "Più chiaro sfavilla,",
      "zh": "更明亮地闪耀，",
      "words": [
        { "it": "Più", "ipa": "pju", "zh": "更" },
        { "it": "chiaro", "ipa": "ˈkjaː.ro", "zh": "明亮的" },
        { "it": "sfavilla", "ipa": "sfaˈvil.la", "zh": "闪耀" }
      ],
      "notes": "sfavilla 双 l [ll]，重音在 -vil-；chi 读 [kj]。"
    },
    {
      "section": "A",
      "it": "E terge ogni stilla",
      "zh": "擦干每一滴",
      "words": [
        { "it": "E", "ipa": "e", "zh": "并且" },
        { "it": "terge", "ipa": "ˈtɛr.dʒe", "zh": "擦干" },
        { "it": "ogni", "ipa": "ˈoɲ.ɲi", "zh": "每一个" },
        { "it": "stilla", "ipa": "ˈstil.la", "zh": "水滴" }
      ],
      "notes": "terge 的 e 开口 [ɛ]、g 在 e 前读 [dʒ]；ogni 的 gn [ɲɲ]；stilla 双 l。"
    },
    {
      "section": "A",
      "it": "Dell'alba che piange.",
      "zh": "哭泣黎明的泪珠。",
      "words": [
        { "it": "Dell'alba", "ipa": "dellˈal.ba", "zh": "黎明的（di+la）" },
        { "it": "che", "ipa": "ke", "zh": "（关系代词）" },
        { "it": "piange", "ipa": "ˈpjan.dʒe", "zh": "哭泣" }
      ],
      "notes": "Dell'alba 双 l [ll]；piange 的 g 在 e 前读 [dʒ]。"
    },
    {
      "section": "B",
      "it": "Col raggio dorato",
      "zh": "用金色的光芒",
      "words": [
        { "it": "Col", "ipa": "kol", "zh": "用（con+il）" },
        { "it": "raggio", "ipa": "ˈrad.dʒo", "zh": "光芒" },
        { "it": "dorato", "ipa": "doˈraː.to", "zh": "金色的" }
      ],
      "notes": "raggio 双 g 读 [ddʒ]，必须延长。"
    },
    {
      "section": "B",
      "it": "Ingemma ogni stelo,",
      "zh": "为每一株草茎镶上宝石，",
      "words": [
        { "it": "Ingemma", "ipa": "inˈdʒem.ma", "zh": "镶上宝石" },
        { "it": "ogni", "ipa": "ˈoɲ.ɲi", "zh": "每一个" },
        { "it": "stelo", "ipa": "ˈstɛː.lo", "zh": "草茎" }
      ],
      "notes": "Ingemma 双 m [mm]、g 在 e 前读 [dʒ]；stelo 的 e 开口 [ɛ]。"
    },
    {
      "section": "B",
      "it": "E gli astri del cielo",
      "zh": "并把天上的星辰",
      "words": [
        { "it": "E", "ipa": "e", "zh": "并且" },
        { "it": "gli", "ipa": "ʎʎi", "zh": "（定冠词复数）" },
        { "it": "astri", "ipa": "ˈas.tri", "zh": "星辰" },
        { "it": "del", "ipa": "del", "zh": "……的" },
        { "it": "cielo", "ipa": "ˈtʃɛː.lo", "zh": "天空" }
      ],
      "notes": "gli 读 [ʎʎ]；cielo 的 e 开口 [ɛ]、c 在 i 前读 [tʃ]。"
    },
    {
      "section": "B",
      "it": "Dipinge nel prato.",
      "zh": "描绘在草地上。",
      "words": [
        { "it": "Dipinge", "ipa": "diˈpin.dʒe", "zh": "描绘" },
        { "it": "nel", "ipa": "nel", "zh": "在……上" },
        { "it": "prato", "ipa": "ˈpraː.to", "zh": "草地" }
      ],
      "notes": "Dipinge 的 g 在 e 前读 [dʒ]；prato 的 a 开口长音，收束明亮。"
    }
  ],
  "diction_notes": [
    "sole 的开口 [ɔ] 与 cielo、stelo 的开口 [ɛ] 是本曲元音色彩的基础——日出场景要求所有开口元音都明亮、开阔。",
    "双辅音：sfavilla [ll]、stilla [ll]、Dell'alba [ll]、raggio [ddʒ]、Ingemma [mm]。",
    "gli/gn 音：gli astri [ʎʎ]、ogni [ɲɲ] 是意大利语特色音，本曲各出现两次。",
    "c/g 的规则变化：Gange [ɡ]+[dʒ]、terge [dʒ]、piange [dʒ]、raggio [ddʒ]、cielo [tʃ]——是清浊塞擦音的组合练习。",
    "太阳上升的意象由长音阶表达，长串音阶上的元音要保持统一色彩，不因音高变化变形。",
    "巴黎奥蒂版用重复词句打破音阶的\"太阳升起\"象征，本谱按斯卡拉蒂原意演唱。"
  ],
  "practice_tips": [
    "全曲是两段镜像结构（A 与 B 各四句），先分别练熟再连起来。",
    "长音阶跑动（尤其 sun 上升动机）先放慢用元音唱，再加速。",
    "gli/gn 音逐词慢练：gli astri、ogni stelo，舌面贴硬腭。",
    "保持全曲的\"清晨\"明亮性格：开口元音唱开、辅音干净、节奏流动，不拖沓。"
  ]
}
