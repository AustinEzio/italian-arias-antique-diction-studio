  "composer": {
    "name": "François Joseph Fétis（曾伪托 Stradella）",
    "life": "1784–1871"
  },
  "source": "1833 年巴黎首演（伪托为斯特拉代拉作品），1838 年 D 小调出版，1843 年以《Pietà, Signore》之名 C 小调出版；《26 Italian Songs and Arias》第25首；歌词为19世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "（1843 版 C 小调，人声+钢琴）",
  "tempo": "行板，庄重而深情（Andante）",
  "structure": "通谱（两段对句）",
  "intro": "本曲 1833 年由男高音在巴黎一场古乐音乐会上首唱，被描述为\"斯特拉代拉（1667）所作的教堂咏叹调、宗教表情与柔情之作\"——组织者费蒂斯（Fétis）声称藏有斯特拉代拉原稿却从未示人。1838 年以 D 小调带弦乐伴奏出版；1843 年费蒂斯以 C 小调、钢琴伴奏和\"Pietà, Signore\"（主啊，怜悯）的新词再版，很快传遍意大利，成为著名曲目。1866 年法国音乐学家理查发现：这段歌词其实配着不同的音乐出现在 A.斯卡拉蒂的清唱剧《圣泰奥多西娅殉道》（1693）中，且歌词的\"柔情\"毫无宗教色彩。费蒂斯去世后其藏书被布鲁塞尔皇家图书馆收购，其中并无斯特拉代拉咏叹调——所有证据都指向费蒂斯本人才是真正作者。歌词：\"如果我的叹息，哦天哪，能平息那曾诱惑我的无情面容：那么所有的痛苦，哪怕置我于死地，我也将永远忠贞地承受。\"",
  "lyrics": [
    {
      "section": "A",
      "it": "Se i miei sospiri,",
      "zh": "如果我的叹息，",
      "words": [
        { "it": "Se", "ipa": "se", "zh": "如果" },
        { "it": "i", "ipa": "i", "zh": "（定冠词复数）" },
        { "it": "miei", "ipa": "ˈmjɛi", "zh": "我的" },
        { "it": "sospiri", "ipa": "soˈspiː.ri", "zh": "叹息" }
      ],
      "notes": "miei 的 e 开口 [ɛ]；sospiri 重音在 -spi-。"
    },
    {
      "section": "A",
      "it": "Oh Dio! placassero",
      "zh": "哦天哪！能平息",
      "words": [
        { "it": "Oh", "ipa": "ɔ", "zh": "哦" },
        { "it": "Dio", "ipa": "ˈdiː.o", "zh": "天哪（呼语）" },
        { "it": "placassero", "ipa": "plaˈkas.se.ro", "zh": "能平息（placare 虚拟式）" }
      ],
      "notes": "Oh 的 o 开口 [ɔ]（感叹词惯例）；placassero 双 s [ss]。"
    },
    {
      "section": "A",
      "it": "L'empio sembiante",
      "zh": "那无情的面容",
      "words": [
        { "it": "L'empio", "ipa": "ˈlɛm.pjo", "zh": "无情的（empio）" },
        { "it": "sembiante", "ipa": "semˈbjan.te", "zh": "面容" }
      ],
      "notes": "empio 的 e 开口 [ɛ]。"
    },
    {
      "section": "A",
      "it": "Che m'allettò:",
      "zh": "曾诱惑我的：",
      "words": [
        { "it": "Che", "ipa": "ke", "zh": "（关系代词）" },
        { "it": "m'allettò", "ipa": "malleˈttɔ", "zh": "诱惑我（allettare 远过去时）" }
      ],
      "notes": "m'allettò 双 l [ll]、双 t [tt]、词尾 ò 开口 [ɔ]。"
    },
    {
      "section": "B",
      "it": "Tutti i martiri",
      "zh": "那么所有的痛苦",
      "words": [
        { "it": "Tutti", "ipa": "ˈtut.ti", "zh": "所有的" },
        { "it": "i", "ipa": "i", "zh": "（定冠词复数）" },
        { "it": "martiri", "ipa": "marˈtiː.ri", "zh": "痛苦、殉难" }
      ],
      "notes": "Tutti 双 t [tt]；martiri 重音在 -ti-。"
    },
    {
      "section": "B",
      "it": "Che morte dassero,",
      "zh": "哪怕置我于死地，",
      "words": [
        { "it": "Che", "ipa": "ke", "zh": "即使" },
        { "it": "morte", "ipa": "ˈmor.te", "zh": "死亡" },
        { "it": "dassero", "ipa": "ˈdas.se.ro", "zh": "给予（dare 虚拟式）" }
      ],
      "notes": "morte 的 o 闭口 [o]；dassero 双 s [ss]。"
    },
    {
      "section": "B",
      "it": "Sempre costante",
      "zh": "我也将永远忠贞地",
      "words": [
        { "it": "Sempre", "ipa": "ˈsɛm.pre", "zh": "永远" },
        { "it": "costante", "ipa": "kosˈtan.te", "zh": "忠贞的" }
      ],
      "notes": "Sempre 的 e 开口 [ɛ]。"
    },
    {
      "section": "B",
      "it": "Io soffrirò.",
      "zh": "承受。",
      "words": [
        { "it": "Io", "ipa": "ˈiː.o", "zh": "我" },
        { "it": "soffrirò", "ipa": "soffriˈrɔ", "zh": "将承受（soffrire 第一人称将来时）" }
      ],
      "notes": "soffrirò 双 f [ff]、词尾 ò 开口 [ɔ]。"
    }
  ],
  "diction_notes": [
    "本曲双辅音密度高：placassero [ss]、m'allettò [ll]+[tt]、Tutti [tt]、dassero [ss]、soffrirò [ff]。",
    "开闭口：miei [ɛ]、empio [ɛ]、Sempre [ɛ]、Oh [ɔ]、m'allettò [ɔ]、soffrirò [ɔ] 与 morte [o]。",
    "虚拟式（placassero/dassero）表愿望：唱出\"如果……该多好\"的叹息感。",
    "本曲的真作者是费蒂斯本人（伪托斯特拉代拉），演唱史常以\"Pietà, Signore\"版本知名——本谱用原始歌词与旋律。",
    "语气庄重而深情：虽被列入\"教堂咏叹调\"，歌词实为世俗的苦恋，演唱保持克制的高贵。"
  ],
  "practice_tips": [
    "首句 Se i miei sospiri 是全曲情绪起点，s 辅音轻起、miei 开口 [ɛ] 唱圆。",
    "两个虚拟式长句（placassero/dassero）练气息分配与句尾收束。",
    "B 段（Tutti i martiri…）是誓言式推进，力度渐强至 soffrirò 的收束。",
    "全曲速度平稳（Andante），不要唱成哀歌式的拖沓。"
  ]
}
