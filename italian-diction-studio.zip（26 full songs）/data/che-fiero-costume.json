  "composer": {
    "name": "Giovanni Legrenzi",
    "life": "1626–1690"
  },
  "source": "出自康塔塔《Echi di riverenza》Op.14（博洛尼亚，1678）；《26 Italian Songs and Arias》第4首；歌词为17世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "12/8",
  "tempo": "中速，12/8 舞曲律动",
  "structure": "通谱（两段感叹 + 收束）",
  "intro": "莱格伦齐（Giovanni Legrenzi）是北意大利重要的管风琴家与歌剧作曲家，晚年像前辈蒙特威尔第一样执掌威尼斯圣马可大教堂音乐。本曲出自 1678 年出版的康塔塔《Echi di riverenza》。歌词是一位被爱神戏弄者的感叹：\"多么残酷的行径，属于那长翅膀的神——竟用痛苦的力量强迫人们膜拜！那背信的神用一张可爱的面容让我崇拜。多么残酷的命运，让一个瞎眼的孩童用乳臭未干的嘴就能让人敬畏！但这暴君用野蛮的欺骗从眼睛进入，让我叹息。\"1680 年莱格伦齐将这段旋律用于歌剧《Eteocle e Polinice》，换上\"Festeggia mio core\"（庆祝吧，我的心）的歌词。",
  "lyrics": [
    {
      "section": "A",
      "it": "Che fiero costume",
      "zh": "多么残酷的行径",
      "words": [
        { "it": "Che", "ipa": "ke", "zh": "多么" },
        { "it": "fiero", "ipa": "ˈfjɛː.ro", "zh": "残酷的、高傲的" },
        { "it": "costume", "ipa": "kosˈtuː.me", "zh": "行径、习惯" }
      ],
      "notes": "fiero 的 e 开口 [ɛ]；costume 的 o 闭口 [o]。"
    },
    {
      "section": "A",
      "it": "D'aligero nume,",
      "zh": "属于那长翅膀的神，",
      "words": [
        { "it": "D'aligero", "ipa": "daˈliː.dʒe.ro", "zh": "长翅膀的（aligero，诗语）" },
        { "it": "nume", "ipa": "ˈnuː.me", "zh": "神（诗语）" }
      ],
      "notes": "aligero 的 g 在 e 前读 [dʒ]；nume 的 u 闭口长音。"
    },
    {
