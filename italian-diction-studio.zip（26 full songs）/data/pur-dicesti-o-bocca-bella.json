{
  "id": "pur-dicesti-o-bocca-bella",
  "number": 12,
  "title": {
    "it": "Pur dicesti, o bocca bella",
    "zh": "你终于说出了，哦美丽的嘴"
  },
  "composer": {
    "name": "Antonio Lotti",
    "life": "1667–1740"
  },
  "source": "手稿 D.7132（巴黎国家图书馆，含\"32 Arias by Sigr. Anto. Lotti\"）；《26 Italian Songs and Arias》第12首；歌词为17世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "（原谱 E 大调，人声+通奏低音）",
  "tempo": "行板，温柔而喜悦",
  "structure": "通谱（短小咏叹调）",
  "intro": "洛蒂（Antonio Lotti）自幼在威尼斯圣马可大教堂跟随莱格伦齐（前曲作者）唱童声，晚年成为该堂乐长，另作有约 30 部歌剧。本曲出处不详：巴黎手稿收录了洛蒂的 32 首咏叹调，本曲是其中唯一主要由通奏低音伴奏的一首。歌词是表白成功者的欢欣：\"你终于说出了，哦美丽的嘴，那甜蜜而珍贵的'愿意'，它带给我全部的欢愉。为了他那火炬的荣光，爱神用一个吻打开了你的唇——那欢乐的甜蜜源泉。\"",
  "lyrics": [
    {
      "section": "A",
      "it": "Pur dicesti, o bocca bella,",
      "zh": "你终于说出了，哦美丽的嘴，",
      "words": [
        { "it": "Pur", "ipa": "pur", "zh": "终于" },
        { "it": "dicesti", "ipa": "diˈtʃes.ti", "zh": "你说出了（dire 远过去时）" },
        { "it": "o", "ipa": "o", "zh": "哦" },
        { "it": "bocca", "ipa": "ˈbɔk.ka", "zh": "嘴" },
        { "it": "bella", "ipa": "ˈbɛl.la", "zh": "美丽的" }
      ],
      "notes": "bocca 双 c [kk]、o 开口 [ɔ]；bella 双 l [ll]、e 开口 [ɛ]。"
    },
    {
      "section": "A",
      "it": "Quel soave e caro sì,",
      "zh": "那甜蜜而珍贵的“愿意”，",
      "words": [
        { "it": "Quel", "ipa": "kwel", "zh": "那个" },
        { "it": "soave", "ipa": "soˈaː.ve", "zh": "甜蜜的" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "caro", "ipa": "ˈkaː.ro", "zh": "珍贵的" },
        { "it": "sì", "ipa": "si", "zh": "愿意、是的" }
      ],
      "notes": "soave 的 o 闭口 [o]；sì 重音在词尾，是全句的核心词。"
    },
    {
      "section": "A",
      "it": "Che fa tutto il mio piacer.",
      "zh": "它带给我全部的欢愉。",
      "words": [
        { "it": "Che", "ipa": "ke", "zh": "（关系代词）" },
        { "it": "fa", "ipa": "fa", "zh": "做、造成" },
        { "it": "tutto", "ipa": "ˈtut.to", "zh": "全部的" },
        { "it": "il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "mio", "ipa": "ˈmiː.o", "zh": "我的" },
        { "it": "piacer", "ipa": "pjaˈtʃer", "zh": "欢愉（piacere 的缩略）" }
      ],
      "notes": "tutto 双 t [tt]；piacer 的 e 闭口 [e]、ci 读 [tʃ]、重音词尾。"
    },
    {
      "section": "B",
      "it": "Per onor di sua facella",
      "zh": "为了他那火炬的荣光",
      "words": [
        { "it": "Per", "ipa": "per", "zh": "为了" },
        { "it": "onor", "ipa": "oˈnor", "zh": "荣誉（onore 的缩略）" },
        { "it": "di", "ipa": "di", "zh": "……的" },
        { "it": "sua", "ipa": "ˈsuː.a", "zh": "他的" },
        { "it": "facella", "ipa": "faˈtʃel.la", "zh": "火炬（fiaccola 的诗语）" }
      ],
      "notes": "onor 的 o 闭口 [o]、重音词尾；facella 双 l [ll]、ci 读 [tʃ]。"
    },
    {
      "section": "B",
      "it": "Con un bacio Amor t'aprì,",
      "zh": "爱神用一个吻打开了你的唇，",
      "words": [
        { "it": "Con", "ipa": "kon", "zh": "用" },
        { "it": "un", "ipa": "un", "zh": "一个" },
        { "it": "bacio", "ipa": "ˈbaː.tʃo", "zh": "吻" },
        { "it": "Amor", "ipa": "aˈmor", "zh": "爱神（Amore）" },
        { "it": "t'aprì", "ipa": "taˈpri", "zh": "向你打开（aprire 远过去时）" }
      ],
      "notes": "bacio 的 c 在 i 前读 [tʃ]；t'aprì 重音词尾 i。"
    },
    {
      "section": "B",
      "it": "Dolce fonte del goder.",
      "zh": "那欢乐的甜蜜源泉。",
      "words": [
        { "it": "Dolce", "ipa": "ˈdol.tʃe", "zh": "甜蜜的" },
        { "it": "fonte", "ipa": "ˈfon.te", "zh": "源泉" },
        { "it": "del", "ipa": "del", "zh": "……的" },
        { "it": "goder", "ipa": "ɡoˈder", "zh": "欢乐（godere 的缩略）" }
      ],
      "notes": "Dolce 的 o 闭口 [o]、c 在 e 前读 [tʃ]；goder 重音词尾。"
    }
  ],
  "diction_notes": [
    "双辅音密集：bocca [kk]、bella [ll]、tutto [tt]、facella [ll]。",
    "开闭口：bella [ɛ]、Dolce [o]、soave [o]、piacer [e]、goder [e]——每句都有对比。",
    "古语缩略：piacer、onor、goder、facella、Amor——重音词尾是共同规律。",
    "sì 是整曲的\"题眼\"（那声\"愿意\"），每个长音上的 sì 都要唱得满足、明亮。",
    "语气是表白成功的幸福宣言：A 段喜悦陈述，B 段叙述爱神的助力，句尾“甜蜜源泉”收束在满足感上。"
  ],
  "practice_tips": [
    "sì 的开口 i 长音单独练：保持高位、不挤不压。",
    "双辅音串（bocca/bella/tutto/facella）按拍子打满时值。",
    "全曲表情温柔，力度 mf 封顶；每句句尾的缩略词（piacer/onor/goder）重音自然落在最后。",
    "Gevaert 版附加的装饰音过于繁琐、需大幅减速才可完成，按本谱演唱即可，不必强加装饰。"
  ]
}
