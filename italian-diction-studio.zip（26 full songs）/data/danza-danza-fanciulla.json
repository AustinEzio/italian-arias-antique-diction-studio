{
  "id": "danza-danza-fanciulla",
  "number": 19,
  "title": {
    "it": "Danza, danza, fanciulla",
    "zh": "跳舞吧，跳舞吧，姑娘"
  },
  "composer": {
    "name": "Francesco Durante",
    "life": "1684–1755"
  },
  "source": "原为《Solfèges d'Italie》No.113（巴黎，1772）无词练声曲，歌词 1874 年始见于《Échos d'Italie》；《26 Italian Songs and Arias》第19首；歌词为19世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "（原谱 C 小调 6/4；歌词版移调 B 小调 3/4）",
  "tempo": "活泼的快板（Allegro con spirito，歌词版）",
  "structure": "通谱（舞曲式咏叹调）",
  "intro": "与第 18 首《Vergin, tutt'amor》同源：本曲原为 1772 年巴黎《意大利练声曲集》中的第 113 首无词练声曲（6/4、C 小调），1874 年配上歌词后移调 B 小调、3/4、Allegro con spirito。歌词是轻快的邀舞：\"跳舞吧，温柔的姑娘，和着我的歌声！旋转吧，轻盈的、苗条的，和着海浪的声响！听那美妙的声响来自嬉戏的微风，它在心里说话、带着慵懒的声音，并邀请舞蹈——就在大海之旁！\"若不唱词，大量重复音是练断音（staccato）的好材料。",
  "lyrics": [
    {
      "section": "A",
      "it": "Danza, fanciulla gentile,",
      "zh": "跳舞吧，温柔的姑娘，",
      "words": [
        { "it": "Danza", "ipa": "ˈdan.tsa", "zh": "跳舞（命令式）" },
        { "it": "fanciulla", "ipa": "fanˈtʃul.la", "zh": "姑娘" },
        { "it": "gentile", "ipa": "dʒenˈtiː.le", "zh": "温柔的" }
      ],
      "notes": "Danza 的 z 读 [ts]；fanciulla 双 l [ll]、c 在 i 前读 [tʃ]。"
    },
    {
      "section": "A",
      "it": "Al mio cantar!",
      "zh": "和着我的歌声！",
      "words": [
        { "it": "Al", "ipa": "al", "zh": "随着（a+il）" },
        { "it": "mio", "ipa": "ˈmiː.o", "zh": "我的" },
        { "it": "cantar", "ipa": "kanˈtar", "zh": "歌唱（cantare 的缩略）" }
      ],
      "notes": "cantar 重音词尾。"
    },
    {
      "section": "A",
      "it": "Gira, leggera, sottile,",
      "zh": "旋转吧，轻盈的，苗条的，",
      "words": [
        { "it": "Gira", "ipa": "ˈdʒiː.ra", "zh": "旋转（命令式）" },
        { "it": "leggera", "ipa": "ledˈdʒɛː.ra", "zh": "轻盈的" },
        { "it": "sottile", "ipa": "sotˈtiː.le", "zh": "苗条的" }
      ],
      "notes": "Gira 的 g 在 i 前读 [dʒ]；leggera 双 g [ddʒ]、e 开口 [ɛ]；sottile 双 t [tt]。"
    },
    {
      "section": "A",
      "it": "Al suon dell'onde del mar!",
      "zh": "和着海浪的声响！",
      "words": [
        { "it": "Al", "ipa": "al", "zh": "随着" },
        { "it": "suon", "ipa": "ˈswɔn", "zh": "声响（suono 的缩略）" },
        { "it": "dell'onde", "ipa": "dellˈon.de", "zh": "海浪的（di+le）" },
        { "it": "del", "ipa": "del", "zh": "……的" },
        { "it": "mar", "ipa": "mar", "zh": "海（mare 的缩略）" }
      ],
      "notes": "suon 的 o 开口 [ɔ]；dell'onde 双 l [ll]。"
    },
    {
      "section": "B",
      "it": "Senti il vago rumore",
      "zh": "听那美妙的声响",
      "words": [
        { "it": "Senti", "ipa": "ˈsɛn.ti", "zh": "请听" },
        { "it": "il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "vago", "ipa": "ˈvaː.ɡo", "zh": "美妙的" },
        { "it": "rumore", "ipa": "ruˈmoː.re", "zh": "声响" }
      ],
      "notes": "Senti 的 e 开口 [ɛ]。"
    },
    {
      "section": "B",
      "it": "Dell'aura scherzosa,",
      "zh": "来自嬉戏的微风，",
      "words": [
        { "it": "Dell'aura", "ipa": "dellˈaw.ra", "zh": "微风的（di+la）" },
        { "it": "scherzosa", "ipa": "skerˈtsɔː.za", "zh": "嬉戏的" }
      ],
      "notes": "Dell'aura 双 l [ll]；scherzosa 的 z 读 [ts]、o 开口 [ɔ]。"
    },
    {
      "section": "B",
      "it": "Che parla in core",
      "zh": "它在心里说话",
      "words": [
        { "it": "Che", "ipa": "ke", "zh": "（关系代词）" },
        { "it": "parla", "ipa": "ˈpar.la", "zh": "说话" },
        { "it": "in", "ipa": "in", "zh": "在……中" },
        { "it": "core", "ipa": "ˈkɔː.re", "zh": "心（cuore 的诗语）" }
      ],
      "notes": "core 的 o 开口 [ɔ]。"
    },
    {
      "section": "B",
      "it": "Con languido suon",
      "zh": "带着慵懒的声音",
      "words": [
        { "it": "Con", "ipa": "kon", "zh": "带着" },
        { "it": "languido", "ipa": "ˈlaŋ.ɡwi.do", "zh": "慵懒的" },
        { "it": "suon", "ipa": "ˈswɔn", "zh": "声音（suono 的缩略）" }
      ],
      "notes": "languido 的 ng 读 [ŋɡ]；suon 的 o 开口 [ɔ]。"
    },
    {
      "section": "B",
      "it": "E che invita alla danza",
      "zh": "并邀请舞蹈",
      "words": [
        { "it": "E", "ipa": "e", "zh": "并" },
        { "it": "che", "ipa": "ke", "zh": "（关系代词）" },
        { "it": "invita", "ipa": "inˈviː.ta", "zh": "邀请" },
        { "it": "alla", "ipa": "ˈal.la", "zh": "到……（a+la）" },
        { "it": "danza", "ipa": "ˈdan.tsa", "zh": "舞蹈" }
      ],
      "notes": "alla 双 l [ll]；danza 的 z 读 [ts]。"
    },
    {
      "section": "B",
      "it": "D'appresso il mare!",
      "zh": "就在大海之旁！",
      "words": [
        { "it": "D'appresso", "ipa": "dapˈprɛs.so", "zh": "在……旁（di+appresso）" },
        { "it": "il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "mare", "ipa": "ˈmaː.re", "zh": "海" }
      ],
      "notes": "D'appresso 双 p [pp]、双 s [ss]、e 开口 [ɛ]。"
    }
  ],
  "diction_notes": [
    "本曲是 3/4 舞曲节奏的断音练习场：Danza、Gira、Senti 三处命令式是全曲骨架。",
    "双辅音密集：fanciulla [ll]、leggera [ddʒ]、sottile [tt]、dell'onde [ll]、Dell'aura [ll]、D'appresso [pp]+[ss]。",
    "z 读 [ts]：Danza、scherzosa。",
    "古语缩略：cantar、mar、suon、core——重音词尾。",
    "若不带词演唱，重复音是断音（staccato）训练；带词演唱保持轻快、俏皮。",
    "巴黎奥蒂版伴奏为晚期浪漫钢琴风格且改动部分歌词，本谱按原版。"
  ],
  "practice_tips": [
    "三拍子舞曲律动先打稳：重音在每小节第一拍，断音干脆。",
    "双辅音串（fanciulla/leggera/sottile）慢练时值再加速。",
    "B 段（Senti il vago rumore…）是乐句延展处，注意气息连贯。",
    "结尾 D'appresso il mare 的 [pp]+[ss] 是收束的高点，干脆利落。"
  ]
}
