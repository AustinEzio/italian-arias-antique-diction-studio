{
  "id": "non-posso-disperar",
  "number": 13,
  "title": {
    "it": "Non posso disperar",
    "zh": "我不能绝望"
  },
  "composer": {
    "name": "Giovanni Bononcini",
    "life": "1670–1747"
  },
  "source": "出自歌剧《Eraclea》中的附加咏叹调（罗马，1690年代）；《26 Italian Songs and Arias》第13首；歌词为17世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "（原谱 G 小调，人声+通奏低音）",
  "tempo": "行板，克制而深情",
  "structure": "通谱（短小咏叹调）",
  "intro": "博农奇尼（Giovanni Bononcini）是莫德纳出身、罗马成名，后与亨德尔在伦敦竞争的意大利歌剧作曲家。本曲是他为罗马托尔迪诺纳剧院上演的既有歌剧《Eraclea》所写的附加咏叹调，由罗马王罗慕路斯演唱：他爱上了一位萨宾贵族女子埃里克莱娅（传说中罗马人抢夺萨宾妇女，她是其中之一），明知对方不爱自己，仍唱道：\"我不能绝望！你对我心来说太珍贵。仅仅是希望终将获得欢乐，对我来说就是甜蜜的煎熬、珍贵的痛苦。\"音乐史家评其\"和声上是大胆的创新者，充满不寻常的不协和与快速转调\"。",
  "lyrics": [
    {
      "section": "A",
      "it": "Non posso disperar!",
      "zh": "我不能绝望！",
      "words": [
        { "it": "Non", "ipa": "non", "zh": "不" },
        { "it": "posso", "ipa": "ˈpɔs.so", "zh": "我能" },
        { "it": "disperar", "ipa": "dispeˈrar", "zh": "绝望（disperare 的缩略）" }
      ],
      "notes": "posso 双 s [ss]、o 开口 [ɔ]；disperar 重音词尾。"
    },
    {
      "section": "A",
      "it": "Sei troppo cara al cor.",
      "zh": "你对我心来说太珍贵。",
      "words": [
        { "it": "Sei", "ipa": "sɛi", "zh": "你是" },
        { "it": "troppo", "ipa": "ˈtrɔp.po", "zh": "太" },
        { "it": "cara", "ipa": "ˈkaː.ra", "zh": "珍贵的" },
        { "it": "al", "ipa": "al", "zh": "对于（a+il）" },
        { "it": "cor", "ipa": "kor", "zh": "心（cuore 的缩略）" }
      ],
      "notes": "Sei 的 e 开口 [ɛ]；troppo 双 p [pp]、o 开口 [ɔ]；cor 的 o 闭口 [o]。"
    },
    {
      "section": "B",
      "it": "Il solo sperare",
      "zh": "仅仅是希望",
      "words": [
        { "it": "Il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "solo", "ipa": "ˈsɔː.lo", "zh": "仅仅" },
        { "it": "sperare", "ipa": "speˈraː.re", "zh": "希望" }
      ],
      "notes": "solo 的 o 开口 [ɔ]。"
    },
    {
      "section": "B",
      "it": "D'aver a gioire",
      "zh": "终将获得欢乐",
      "words": [
        { "it": "D'aver", "ipa": "daˈver", "zh": "拥有（di+avere）" },
        { "it": "a", "ipa": "a", "zh": "（介词）" },
        { "it": "gioire", "ipa": "dʒoˈiː.re", "zh": "欢乐" }
      ],
      "notes": "gioire 的 gi 读 [dʒ]；重音在 -i-。"
    },
    {
      "section": "B",
      "it": "M'è un dolce languire,",
      "zh": "对我来说就是甜蜜的煎熬，",
      "words": [
        { "it": "M'è", "ipa": "mɛ", "zh": "对我是（mi+è）" },
        { "it": "un", "ipa": "un", "zh": "一种" },
        { "it": "dolce", "ipa": "ˈdol.tʃe", "zh": "甜蜜的" },
        { "it": "languire", "ipa": "lanˈɡwiː.re", "zh": "煎熬（languire 名词化）" }
      ],
      "notes": "M'è 的 è 开口 [ɛ]；dolce 的 o 闭口 [o]。"
    },
    {
      "section": "B",
      "it": "M'è un caro dolor.",
      "zh": "对我来说就是珍贵的痛苦。",
      "words": [
        { "it": "M'è", "ipa": "mɛ", "zh": "对我是" },
        { "it": "un", "ipa": "un", "zh": "一种" },
        { "it": "caro", "ipa": "ˈkaː.ro", "zh": "珍贵的" },
        { "it": "dolor", "ipa": "doˈlor", "zh": "痛苦（dolore 的缩略）" }
      ],
      "notes": "dolor 的 o 闭口 [o]、重音词尾——\"甜蜜的煎熬\"与\"珍贵的痛苦\"是互文的收束。"
    }
  ],
  "diction_notes": [
    "开闭口对比是表情核心：posso [ɔ]、troppo [ɔ]、solo [ɔ]（沉重）与 cor/dolce/dolor 的 [o]（温柔）交替。",
    "双辅音：posso [ss]、troppo [pp]。",
    "古语缩略：disperar、cor、dolor、D'aver——重音词尾。",
    "M'è un 的连读要顺滑：m'è 开口 [ɛ] 后接 un，不添加停顿。",
    "全曲是\"绝望中的执念\"：句句否定（Non…、Il solo…），语气是克制而坚定的哀伤，不是嚎啕。",
    "巴黎奥蒂版误标作曲家为 Severo de Luca 并添加了不合理的强音与变音，本谱按博农奇尼原貌。"
  ],
  "practice_tips": [
    "首句 Non posso disperar 三个词、三个辅音重音（n/ss/r），先慢读再唱。",
    "两处 M'è un 的连读是 legato 练习点。",
    "全曲六句一气呵成的情感弧线：喊（我不能绝望）→ 诉（你太珍贵）→ 悟（希望即甜蜜的煎熬）。",
    "保持小调的克制色彩，全曲 mf 以下；结尾 dolor 轻轻收束，不拖沓。"
  ]
}
