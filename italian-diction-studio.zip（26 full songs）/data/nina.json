{
  "id": "nina",
  "number": 21,
  "title": {
    "it": "Nina",
    "zh": "尼娜"
  },
  "composer": {
    "name": "佚名（曾误归于 Pergolesi 等）",
    "life": "18世纪"
  },
  "source": "出自歌剧《Li tre cicisbei ridicoli》（伦敦，1749）中的小夜曲；《26 Italian Songs and Arias》第21首；歌词为18世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "（原谱 G 小调，人声+弦乐+数字低音）",
  "tempo": "小行板，轻柔如小夜曲（Andantino）",
  "structure": "两段诗节（A A'）",
  "intro": "《尼娜》自 1749 年由意大利歌剧团在伦敦演出后流行至今。歌剧《三个荒唐的追求者》中并无角色叫尼娜，此曲与剧情无直接联系，只是作为小夜曲演唱。流传中曾附会佩尔戈莱西（已于 1736 年去世，几乎不可能）、恰姆皮、雷斯塔等作曲家之名，均无文献实据。歌词诙谐：\"尼娜已经三天卧床不起，睡意正吞噬着她——唤醒她吧，行行好！让铙钹、鼓和笛子都来吧，把我的小尼娜唤醒，让她不再沉睡。而当那位医生先生前去探视她，小尼娜，为了爱情，仍卧床不起。\"——\"病\"实为相思病。",
  "lyrics": [
    {
      "section": "A",
      "it": "Tre giorni son che Nina",
      "zh": "尼娜已经三天",
      "words": [
        { "it": "Tre", "ipa": "tre", "zh": "三" },
        { "it": "giorni", "ipa": "ˈdʒor.ni", "zh": "天" },
        { "it": "son", "ipa": "son", "zh": "有（sono 的缩略）" },
        { "it": "che", "ipa": "ke", "zh": "（连词）" },
        { "it": "Nina", "ipa": "ˈniː.na", "zh": "尼娜（女子名）" }
      ],
      "notes": "giorni 的 gi 读 [dʒ]、o 闭口 [o]。"
    },
    {
      "section": "A",
      "it": "In letto se ne sta.",
      "zh": "卧床不起。",
      "words": [
        { "it": "In", "ipa": "in", "zh": "在……中" },
        { "it": "letto", "ipa": "ˈlɛt.to", "zh": "床" },
        { "it": "se", "ipa": "se", "zh": "自己（反身）" },
        { "it": "ne", "ipa": "ne", "zh": "（小品词）" },
        { "it": "sta", "ipa": "sta", "zh": "待着" }
      ],
      "notes": "letto 双 t [tt]、e 开口 [ɛ]。"
    },
    {
      "section": "A",
      "it": "Il sonno l'assassina—",
      "zh": "睡意正吞噬着她——",
      "words": [
        { "it": "Il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "sonno", "ipa": "ˈsɔn.no", "zh": "睡意" },
        { "it": "l'assassina", "ipa": "lassasˈsiː.na", "zh": "杀害她（assassinare 第三人称）" }
      ],
      "notes": "sonno 双 n [nn]、o 开口 [ɔ]；assassina 双 s [ss]。"
    },
    {
      "section": "A",
      "it": "Svegliatela, per pietà!",
      "zh": "唤醒她吧，行行好！",
      "words": [
        { "it": "Svegliatela", "ipa": "zveʎˈʎaː.te.la", "zh": "唤醒她（命令式+la）" },
        { "it": "per", "ipa": "per", "zh": "为了" },
        { "it": "pietà", "ipa": "pjeˈta", "zh": "怜悯" }
      ],
      "notes": "Svegliatela 的 s 在浊音 v 前读 [z]、gli 读 [ʎʎ]；pietà 重音词尾。"
    },
    {
      "section": "A",
      "it": "E cimbali e timpani e pifferi,",
      "zh": "让铙钹、鼓和笛子都来吧，",
      "words": [
        { "it": "E", "ipa": "e", "zh": "让" },
        { "it": "cimbali", "ipa": "ˈtʃim.ba.li", "zh": "铙钹" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "timpani", "ipa": "ˈtim.pa.ni", "zh": "定音鼓" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "pifferi", "ipa": "ˈpif.fe.ri", "zh": "双簧管/笛（复数）" }
      ],
      "notes": "cimbali 的 c 在 i 前读 [tʃ]；pifferi 双 f [ff]。"
    },
    {
      "section": "A",
      "it": "Svegliatemi Ninetta",
      "zh": "把我的小尼娜唤醒",
      "words": [
        { "it": "Svegliatemi", "ipa": "zveʎˈʎaː.te.mi", "zh": "为我唤醒（命令式+mi）" },
        { "it": "Ninetta", "ipa": "niˈnɛt.ta", "zh": "小尼娜（Nina 的爱称）" }
      ],
      "notes": "Svegliatemi 的 gli [ʎʎ]；Ninetta 双 t [tt]、e 开口 [ɛ]。"
    },
    {
      "section": "A",
      "it": "Perché (Acciò) non dorma più.",
      "zh": "让她不再沉睡。",
      "words": [
        { "it": "Perché", "ipa": "perˈke", "zh": "使得" },
        { "it": "non", "ipa": "non", "zh": "不" },
        { "it": "dorma", "ipa": "ˈdor.ma", "zh": "沉睡（dormire 虚拟式）" },
        { "it": "più", "ipa": "pju", "zh": "再" }
      ],
      "notes": "Perché 重音词尾、ch 读 [k]；（歌词另作 Acciò，aˈttʃɔ，意为\"使得\"，词尾 ò 开口）。"
    },
    {
      "section": "B",
      "it": "E mentre il sior dottore",
      "zh": "而当那位医生先生",
      "words": [
        { "it": "E", "ipa": "e", "zh": "而当" },
        { "it": "mentre", "ipa": "ˈmɛn.tre", "zh": "当……时" },
        { "it": "il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "sior", "ipa": "sjor", "zh": "先生（signor 的方言缩略）" },
        { "it": "dottore", "ipa": "dotˈtoː.re", "zh": "医生" }
      ],
      "notes": "mentre 的 e 开口 [ɛ]；dottore 双 t [tt]；sior 是威尼斯方言的\"signore\"。"
    },
    {
      "section": "B",
      "it": "A visitarla va,",
      "zh": "前去探视她，",
      "words": [
        { "it": "A", "ipa": "a", "zh": "去" },
        { "it": "visitarla", "ipa": "viziˈtar.la", "zh": "探视她（visitare+la）" },
        { "it": "va", "ipa": "va", "zh": "去" }
      ],
      "notes": "visitarla 的 s 在元音间读浊音 [z]。"
    },
    {
      "section": "B",
      "it": "Ninetta per amore",
      "zh": "小尼娜，为了爱情，",
      "words": [
        { "it": "Ninetta", "ipa": "niˈnɛt.ta", "zh": "小尼娜" },
        { "it": "per", "ipa": "per", "zh": "为了" },
        { "it": "amore", "ipa": "aˈmoː.re", "zh": "爱情" }
      ],
      "notes": "Ninetta 双 t [tt]；amore 的 o 闭口 [o]——\"病根\"点题。"
    },
    {
      "section": "B",
      "it": "In letto se ne sta.",
      "zh": "仍卧床不起。",
      "words": [
        { "it": "In", "ipa": "in", "zh": "在……中" },
        { "it": "letto", "ipa": "ˈlɛt.to", "zh": "床" },
        { "it": "se", "ipa": "se", "zh": "自己" },
        { "it": "ne", "ipa": "ne", "zh": "（小品词）" },
        { "it": "sta", "ipa": "sta", "zh": "待着" }
      ],
      "notes": "再现句：与首句呼应，语气带俏皮的自嘲。"
    }
  ],
  "diction_notes": [
    "本曲双辅音密集：letto [tt]、sonno [nn]、assassina [ss]、Ninetta [tt]、dottore [tt]、pifferi [ff]。",
    "开闭口：letto [ɛ]、Ninetta [ɛ]、mentre [ɛ] 与 sonno [ɔ]、amore [o]、giorni [o]。",
    "s 浊化：Svegliatela/Svegliatemi 的 [z]（s+浊辅音）、visitarla [z]。",
    "方言词：sior（signore 的威尼斯方言）——按意大利语拼读 sjor。",
    "歌词诙谐小夜曲：\"病\"是相思病，演唱带笑意与夸张，不要唱成真的哀伤。",
    "1749 年伦敦版原谱中第一小提琴几乎全程齐奏人声，装饰音（倚音）均为原谱。"
  ],
  "practice_tips": [
    "三组命令式（Svegliatela/Svegliatemi）是全曲的高点，[ʎʎ] 先慢练。",
    "两段诗节 A/B 是重复结构，B 段（医生来探）是叙事情节，唱得更有画面感。",
    "小夜曲语气：轻、俏、带恳求的夸张，节奏流动不拖。",
    "收尾句 In letto se ne sta 与首句呼应，可稍放慢收束，留下\"还是没醒\"的幽默。"
  ]
}
