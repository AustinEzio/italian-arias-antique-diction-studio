        { "it": "se", "ipa": "se", "zh": "如果" },
        { "it": "pensi", "ipa": "ˈpɛn.si", "zh": "你想到" },
        { "it": "che", "ipa": "ke", "zh": "（连词）" },
        { "it": "soletto", "ipa": "soˈlɛt.to", "zh": "独自（solo 的爱称）" }
      ],
      "notes": "pensi 的 e 开口 [ɛ]；soletto 双 t [tt]、e 开口 [ɛ]。"
    },
    {
      "section": "A",
      "it": "Io ti debba riamar,",
