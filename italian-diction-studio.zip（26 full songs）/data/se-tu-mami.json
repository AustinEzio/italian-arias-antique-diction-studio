        { "it": "diletto", "ipa": "diˈlɛt.to", "zh": "欢喜" },
        { "it": "del", "ipa": "del", "zh": "……的" },
        { "it": "tu'", "ipa": "tu", "zh": "你的（tuo 的缩略）" },
        { "it": "amor", "ipa": "aˈmor", "zh": "爱（amore 的缩略）" }
