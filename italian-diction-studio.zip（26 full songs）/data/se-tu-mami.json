    {
      "section": "B",
      "it": "Bella Rosa porporina",
      "zh": "美丽的深红玫瑰",
      "words": [
        { "it": "Bella", "ipa": "ˈbɛl.la", "zh": "美丽的" },
        { "it": "Rosa", "ipa": "ˈrɔː.za", "zh": "玫瑰" },
        { "it": "porporina", "ipa": "porpoˈriː.na", "zh": "深红的" }
      ],
      "notes": "Bella 双 l [ll]、e 开口 [ɛ]；Rosa 的 o 开口 [ɔ]、s 浊音 [z]。"
    },
    {
      "section": "B",
      "it": "Oggi Silvio sceglierà,",
      "zh": "今天希尔维奥会摘取，",
      "words": [
        { "it": "Oggi", "ipa": "ˈɔd.dʒi", "zh": "今天" },
        { "it": "Silvio", "ipa": "ˈsil.vjo", "zh": "希尔维奥（男子名）" },
        { "it": "sceglierà", "ipa": "ʃeʎʎeˈra", "zh": "将选择" }
      ],
      "notes": "Oggi 双 g [ddʒ]、o 开口 [ɔ]；sceglierà 的 sc 读 [ʃ]、gli 读 [ʎʎ]、重音词尾。"
    },
    {
      "section": "B",
      "it": "Con la scusa della Spina",
