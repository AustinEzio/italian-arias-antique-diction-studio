        { "it": "dolor", "ipa": "doˈlor", "zh": "悲伤（dolore 的缩略）" },
        { "it": "de", "ipa": "de", "zh": "为（di 的缩略）" },
        { "it": "tuoi", "ipa": "ˈtwɔi", "zh": "你的" },
        { "it": "martiri", "ipa": "marˈtiː.ri", "zh": "痛苦" }
      ],
      "notes": "Ho 的 o 开口 [ɔ]；tuoi 的 o 开口 [ɔ]。"
    },
    {
      "section": "A",
      "it": "Ho diletto del tu' amor:",
      "zh": "为你的爱而欢喜：",
      "words": [
