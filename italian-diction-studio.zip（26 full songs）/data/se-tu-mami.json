{
  "id": "se-tu-mami",
  "number": 26,
  "title": {
    "it": "Se tu m'ami",
    "zh": "如果你爱我"
  },
  "composer": {
    "name": "Alessandro Parisotti（曾伪托为 Pergolesi）",
    "life": "1853–1913"
  },
  "source": "歌词出自 Paolo Rolli《Di canzonette e di cantate libri due》（伦敦，1727）；音乐为 Parisotti 本人所作（《Arie Antiche》第1卷，1885）；《26 Italian Songs and Arias》第26首；歌词为18世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "（原谱 F 小调，人声+钢琴）",
  "tempo": "晚期浪漫风格，中速（Moderato）",
  "structure": "三段诗节（A A' B）",
  "intro": "本曲 1885 年首次出版于《古代咏叹调》曲集时被呈现为佩尔戈莱西（1710–1736）的作品，但学界早已不接受这一归属：从未发现其早期手稿，且曲集中其他歌曲均出自已知来源——如今普遍认为音乐出自编订者帕里索蒂本人之手。为使伪托更像真的，帕里索蒂借用了 18 世纪诗人保罗·罗利（Paolo Rolli，为亨德尔和博农奇尼写歌剧脚本、旅居伦敦的意大利诗人）的诗作。歌词是一位女子的俏皮宣言：\"如果你爱我、如果你只为我一人叹息，温柔的牧羊人；我为你的痛苦而悲伤，为你的爱而欢喜：但若你以为我必须只爱你一个人，小牧羊人，你很容易就会自作多情。美丽的深红玫瑰今天希尔维奥会摘取，但以刺为借口，明天他就会嫌弃它。但男人们的做法我可不打算学——并非因为我偏爱百合，就要嫌弃别的花。\"帕里索蒂把\"Silvio\"改成\"Silvia\"（仿佛摘玫瑰的是女子本人）是误读。",
  "lyrics": [
    {
      "section": "A",
      "it": "Se tu m'ami, se sospiri",
      "zh": "如果你爱我，如果你叹息",
      "words": [
        { "it": "Se", "ipa": "se", "zh": "如果" },
        { "it": "tu", "ipa": "tu", "zh": "你" },
        { "it": "m'ami", "ipa": "ˈmaː.mi", "zh": "爱我" },
        { "it": "se", "ipa": "se", "zh": "如果" },
        { "it": "sospiri", "ipa": "soˈspiː.ri", "zh": "叹息" }
      ],
      "notes": "sospiri 重音在 -spi-。"
    },
    {
      "section": "A",
      "it": "Sol per me, gentil Pastor;",
      "zh": "只为我一人，温柔的牧羊人；",
      "words": [
        { "it": "Sol", "ipa": "sɔl", "zh": "仅仅（solo 的缩略）" },
