  "title": {
    "it": "Come raggio di sol",
    "zh": "如同阳光"
  },
  "composer": {
    "name": "Antonio Caldara（存疑，可能是浪漫主义时期的仿作）",
    "life": "约1670–1736"
  },
  "source": "出自 19 世纪曲集《Gemme d'antichità》No.77（伦敦，1863–1878 年间）；《26 Italian Songs and Arias》第17首；歌词为18-19世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "（原谱 E 小调，人声+钢琴）",
  "tempo": "行板，沉思而平静",
  "structure": "通谱（两段镜像诗节）",
  "intro": "本曲在 19 世纪的曲集中流传，原始出处不明：卡尔达拉生前著作繁多，在对其全部作品完成考证前，无法确定此曲是其真作还是浪漫主义时期的仿制品。歌词是优美的哲理：\"如同柔和宁静的阳光安歇在平静的波浪上，而大海深邃的怀抱中正潜伏着风暴；同样，有时欢快平静的笑容以满足与喜悦点染一张嘴唇，而那颗受伤的心在隐秘处正痛苦、正折磨自己。\"——微笑掩盖创伤，是典型的 19 世纪沙龙艺术歌曲题材。本谱去除了部分极端表情记号。",
  "lyrics": [
    {
      "section": "A",
      "it": "Come raggio di sol mite e sereno",
      "zh": "如同柔和宁静的阳光",
      "words": [
        { "it": "Come", "ipa": "ˈkoː.me", "zh": "如同" },
        { "it": "raggio", "ipa": "ˈrad.dʒo", "zh": "光芒" },
        { "it": "di", "ipa": "di", "zh": "……的" },
        { "it": "sol", "ipa": "sɔl", "zh": "太阳（sole 的缩略）" },
        { "it": "mite", "ipa": "ˈmiː.te", "zh": "柔和的" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "sereno", "ipa": "seˈreː.no", "zh": "宁静的" }
      ],
      "notes": "raggio 双 g [ddʒ]；sol 的 o 开口 [ɔ]。"
    },
    {
      "section": "A",
      "it": "Sovra placidi flutti si riposa,",
      "zh": "安歇在平静的波浪上，",
      "words": [
        { "it": "Sovra", "ipa": "ˈsoː.vra", "zh": "在……上（sopra 的诗语）" },
        { "it": "placidi", "ipa": "ˈplaː.tʃi.di", "zh": "平静的" },
        { "it": "flutti", "ipa": "ˈflut.ti", "zh": "波浪（诗语）" },
        { "it": "si", "ipa": "si", "zh": "自己（反身）" },
        { "it": "riposa", "ipa": "riˈpɔː.za", "zh": "安歇" }
      ],
      "notes": "flutti 双 t [tt]；riposa 的 o 开口 [ɔ]、s 浊音 [z]。"
    },
    {
      "section": "A",
      "it": "Mentre del mare nel profondo seno",
      "zh": "而当大海深邃的怀抱中",
      "words": [
        { "it": "Mentre", "ipa": "ˈmɛn.tre", "zh": "当……时" },
        { "it": "del", "ipa": "del", "zh": "……的" },
        { "it": "mare", "ipa": "ˈmaː.re", "zh": "海" },
        { "it": "nel", "ipa": "nel", "zh": "在……中" },
        { "it": "profondo", "ipa": "proˈfon.do", "zh": "深邃的" },
        { "it": "seno", "ipa": "ˈsɛː.no", "zh": "怀抱" }
      ],
      "notes": "Mentre 的 e 开口 [ɛ]；seno 的 e 开口 [ɛ]。"
    },
    {
      "section": "A",
      "it": "Sta la tempesta ascosa:",
      "zh": "正潜伏着风暴：",
      "words": [
        { "it": "Sta", "ipa": "sta", "zh": "存在、藏" },
        { "it": "la", "ipa": "la", "zh": "（定冠词）" },
        { "it": "tempesta", "ipa": "temˈpes.ta", "zh": "风暴" },
        { "it": "ascosa", "ipa": "asˈkɔː.za", "zh": "隐藏的" }
      ],
      "notes": "ascosa 的 o 开口 [ɔ]、s 浊音 [z]。"
    },
    {
      "section": "B",
      "it": "Così riso talor gaio e pacato",
      "zh": "同样，有时欢快平静的笑容",
      "words": [
        { "it": "Così", "ipa": "koˈzi", "zh": "同样" },
        { "it": "riso", "ipa": "ˈriː.zo", "zh": "笑容" },
        { "it": "talor", "ipa": "taˈlor", "zh": "有时（talora 的缩略）" },
        { "it": "gaio", "ipa": "ˈɡaː.jo", "zh": "欢快的" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "pacato", "ipa": "paˈkaː.to", "zh": "平静的" }
      ],
      "notes": "Così 的 s 浊音 [z]、重音词尾；talor 重音词尾。"
    },
    {
      "section": "B",
      "it": "Di contento, di gioia un labbro infiora,",
      "zh": "以满足与喜悦点染一张嘴唇，",
      "words": [
        { "it": "Di", "ipa": "di", "zh": "以" },
        { "it": "contento", "ipa": "konˈtɛn.to", "zh": "满足" },
        { "it": "di", "ipa": "di", "zh": "以" },
        { "it": "gioia", "ipa": "ˈdʒɔː.ja", "zh": "喜悦" },
        { "it": "un", "ipa": "un", "zh": "一张" },
        { "it": "labbro", "ipa": "ˈlab.bro", "zh": "嘴唇" },
        { "it": "infiora", "ipa": "infjoˈra", "zh": "点缀、使如花" }
      ],
      "notes": "contento 的 e 开口 [ɛ]；gioia 的 o 开口 [ɔ]；labbro 双 b [bb]。"
    },
    {
      "section": "B",
      "it": "Mentre nel suo segreto il cor piagato",
      "zh": "而当那颗受伤的心在隐秘处",
      "words": [
        { "it": "Mentre", "ipa": "ˈmɛn.tre", "zh": "当……时" },
        { "it": "nel", "ipa": "nel", "zh": "在……中" },
        { "it": "suo", "ipa": "ˈsuː.o", "zh": "它的" },
        { "it": "segreto", "ipa": "seˈɡreː.to", "zh": "隐秘处" },
        { "it": "il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "cor", "ipa": "kor", "zh": "心（cuore 的缩略）" },
        { "it": "piagato", "ipa": "pjaˈɡaː.to", "zh": "受伤的" }
      ],
      "notes": "cor 的 o 闭口 [o]；segreto 的 e 闭口 [e]。"
    },
    {
      "section": "B",
      "it": "S'angoscia e si martora.",
      "zh": "正痛苦、正折磨自己。",
      "words": [
        { "it": "S'angoscia", "ipa": "saŋˈɡɔʃ.ʃa", "zh": "痛苦（angosciarsi 反身）" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "si", "ipa": "si", "zh": "自己" },
        { "it": "martora", "ipa": "ˈmar.to.ra", "zh": "折磨（martorare 第三人称）" }
      ],
      "notes": "S'angoscia 的 o 开口 [ɔ]、sc 读 [ʃ] 且延长 [ʃʃ]；martora 重音在词首。"
    }
  ],
  "diction_notes": [
    "本曲是\"表象与真相\"的哲理歌：A 段（阳光/海面）明亮，B 段（笑容/内心）转折——两段开闭口色彩要随情绪变化。",
    "双辅音/塞擦音：raggio [ddʒ]、flutti [tt]、labbro [bb]、S'angoscia [ʃʃ]。",
    "诗语缩略：sol（sole）、Sovra（sopra）、talor（talora）、cor（cuore）——重音词尾。",
    "原谱标注密集的浪漫主义表情记号，本谱已去除极端部分，演唱仍保持沉思的安静基调。",
    "第六行歌词按原始版本读作\"di gioia un'alma infiora\"（原谱），本谱用\"un labbro infiora\"。"
  ],
  "practice_tips": [
    "两段的结构对比是全曲核心：A 段 mf 平静叙述，B 段（Così riso…）稍亮后转暗。",
    "S'angoscia 的 [ʃʃ] 双辅音是全曲最难点，慢练时值。",
    "长句（Ovunque…）气息要提前规划，句尾渐弱。",
    "本曲旋律抒情性强，先用 a 元音哼唱找线条，再上词。"
  ]
}
