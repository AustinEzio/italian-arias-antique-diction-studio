{
  "id": "se-florinda-e-fedele",
  "number": 10,
  "title": {
    "it": "Se Florinda è fedele",
    "zh": "如果弗洛琳达忠贞"
  },
  "composer": {
    "name": "Alessandro Scarlatti",
    "life": "1660–1725"
  },
  "source": "出自歌剧《La donna ancora è fedele》（那不勒斯，1698）；《26 Italian Songs and Arias》第10首；歌词为17世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "3/8（原谱 C 大调，人声+齐奏小提琴+通奏低音）",
  "tempo": "快板（Allegro，♩=116–138）",
  "structure": "带再现的两段咏叹调（A B A'）",
  "intro": "本曲出自斯卡拉蒂在那不勒斯高产期创作、1698 年上演的歌剧《女人仍然忠贞》。歌者阿里多罗刚偷听到谈话，得知弗洛琳达爱上了自己，于是唱道：\"如果弗洛琳达是忠贞的，我就会坠入爱河。那背着箭囊的弓手尽可以拉满他的弓，因为我懂得如何抵御一个谄媚的目光。祈求、眼泪与哀诉我都不会听；但若她忠贞不渝，我就会坠入爱河。\"（女声演唱时可把名字改为 Florindo。）小提琴与人声的呼应交织是斯卡拉蒂成熟期的典型笔法。",
  "lyrics": [
    {
      "section": "A",
      "it": "Se Florinda è fedele,",
      "zh": "如果弗洛琳达是忠贞的，",
      "words": [
        { "it": "Se", "ipa": "se", "zh": "如果" },
        { "it": "Florinda", "ipa": "floˈrin.da", "zh": "弗洛琳达（女子名）" },
        { "it": "è", "ipa": "ɛ", "zh": "是" },
        { "it": "fedele", "ipa": "feˈdeː.le", "zh": "忠贞的" }
      ],
      "notes": "fedele 的 e 闭口 [e]（与 crudele 的开口 [ɛ] 是经典对比）；è 开口 [ɛ]。"
    },
    {
      "section": "A",
      "it": "Io m'innamorerò.",
      "zh": "我就会坠入爱河。",
      "words": [
        { "it": "Io", "ipa": "ˈiː.o", "zh": "我" },
        { "it": "m'innamorerò", "ipa": "minnamoreˈrɔ", "zh": "我将爱上（innamorarsi 第一人称）" }
      ],
      "notes": "m'innamorerò 双 n [nn] 必须延长；词尾 ò 开口 [ɔ]。"
    },
    {
      "section": "A",
      "it": "Potrà ben l'arco tendere",
      "zh": "那弓手尽可以拉满他的弓",
      "words": [
        { "it": "Potrà", "ipa": "poˈtra", "zh": "将能够" },
        { "it": "ben", "ipa": "bɛn", "zh": "很好地" },
        { "it": "l'arco", "ipa": "ˈlar.ko", "zh": "弓" },
        { "it": "tendere", "ipa": "ˈtɛn.de.re", "zh": "拉（弓）" }
      ],
      "notes": "ben 的 e 开口 [ɛ]（bene 缩略）；tendere 的 e 开口 [ɛ]。"
    },
    {
      "section": "A",
      "it": "Il faretrato arcier,",
      "zh": "那背着箭囊的弓手（丘比特），",
      "words": [
        { "it": "Il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "faretrato", "ipa": "faretˈtraː.to", "zh": "佩箭囊的（诗语）" },
        { "it": "arcier", "ipa": "arˈtʃɛr", "zh": "弓手（arciere 的诗语）" }
      ],
      "notes": "faretrato 双 t [tt]；arcier 的 e 开口 [ɛ]、ci 读 [tʃ]、重音词尾。"
    },
    {
      "section": "A",
      "it": "Ch'io mi saprò difendere",
      "zh": "因为我懂得如何抵御",
      "words": [
        { "it": "Ch'io", "ipa": "ˈkjo", "zh": "因为我（che+io）" },
        { "it": "mi", "ipa": "mi", "zh": "自己" },
        { "it": "saprò", "ipa": "saˈprɔ", "zh": "我将懂得" },
        { "it": "difendere", "ipa": "diˈfɛn.de.re", "zh": "抵御" }
      ],
      "notes": "difendere 的 e 开口 [ɛ]；saprò 词尾 ò 开口 [ɔ]。"
    },
    {
      "section": "A",
      "it": "Da un guardo lusinghier.",
      "zh": "一个谄媚的目光。",
      "words": [
        { "it": "Da", "ipa": "da", "zh": "从" },
        { "it": "un", "ipa": "un", "zh": "一个" },
        { "it": "guardo", "ipa": "ˈɡwar.do", "zh": "目光" },
        { "it": "lusinghier", "ipa": "luzinˈɡjɛr", "zh": "谄媚的（lusinghiero 的诗语）" }
      ],
      "notes": "guardo 的 gu 读 [ɡw]；lusinghier 的 s 浊音 [z]、gh 读 [ɡj]、e 开口 [ɛ]、重音词尾。"
    },
    {
      "section": "B",
      "it": "Preghi, pianti e querele",
      "zh": "祈求、眼泪与哀诉",
      "words": [
        { "it": "Preghi", "ipa": "ˈpreː.ɡi", "zh": "祈求" },
        { "it": "pianti", "ipa": "ˈpjan.ti", "zh": "眼泪" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "querele", "ipa": "kweˈreː.le", "zh": "哀诉" }
      ],
      "notes": "Preghi 的 e 闭口 [e]、gh 读 [ɡ]；querele 的 qu 读 [kw]。"
    },
    {
      "section": "B",
      "it": "Io non ascolterò,",
      "zh": "我都不会听，",
      "words": [
        { "it": "Io", "ipa": "ˈiː.o", "zh": "我" },
        { "it": "non", "ipa": "non", "zh": "不" },
        { "it": "ascolterò", "ipa": "askolteˈrɔ", "zh": "将倾听（第一人称）" }
      ],
      "notes": "ascolterò 词尾 ò 开口 [ɔ]；s 在 c 前读 [s]。"
    },
    {
      "section": "B",
      "it": "Ma se sarà fedele,",
      "zh": "但若她忠贞不渝，",
      "words": [
        { "it": "Ma", "ipa": "ma", "zh": "但是" },
        { "it": "se", "ipa": "se", "zh": "如果" },
        { "it": "sarà", "ipa": "saˈra", "zh": "将是" },
        { "it": "fedele", "ipa": "feˈdeː.le", "zh": "忠贞的" }
      ],
      "notes": "fedele 再次出现，保持闭口 [e]。"
    },
    {
      "section": "B",
      "it": "Io m'innamorerò.",
      "zh": "我就会坠入爱河。",
      "words": [
        { "it": "Io", "ipa": "ˈiː.o", "zh": "我" },
        { "it": "m'innamorerò", "ipa": "minnamoreˈrɔ", "zh": "我将爱上" }
      ],
      "notes": "再现句：双 n [nn] 与词尾开口 [ɔ] 是全曲落点，唱足。"
    }
  ],
  "diction_notes": [
    "本曲的核心对比：fedele（忠贞）闭口 [e]——全曲唱了两次，是\"忠贞\"一词的标准读音。",
    "双辅音：m'innamorerò 的 [nn]、faretrato 的 [tt]。",
    "诗语/古语：arcier（弓手）、lusinghier（谄媚的）、faretrato（佩箭囊的）——都重音词尾、元音色彩要按诗语。",
    "词尾开闭口密集：saprò [ɔ]、ascolterò [ɔ]、innamorerò [ɔ] 都是将来时词尾开口 o，而 fedele、querele 是闭口 e。",
    "语气层次：A 段（条件句）冷静，B 段（列举拒绝）渐强，最后再现\"我会爱上\"坚定收束。",
    "女声可改唱 Florindo；本谱按巴黎奥蒂版惯例使用阳性形式。"
  ],
  "practice_tips": [
    "先分清 fedele 的闭口 [e] 与 è 的开口 [ɛ]——同一句内成对出现。",
    "m'innamorerò 的双 n 与词尾开口 [ɔ] 单独练，是全曲招牌音型。",
    "三拍子 Allegro 保持舞曲弹性；\"Potrà ben l'arco tendere\"的长句练一口气唱完。",
    "对比段（Preghi, pianti…）力度渐强，再现段回到自信的语气。"
  ]
}
