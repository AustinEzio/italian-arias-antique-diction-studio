{
  "id": "o-cessate-di-piagarmi",
  "number": 7,
  "title": {
    "it": "O cessate di piagarmi",
    "zh": "哦，请停止伤害我"
  },
  "composer": {
    "name": "Alessandro Scarlatti",
    "life": "1660–1725"
  },
  "source": "出自歌剧《Pompeo》（罗马，1683）第二幕第五场；《26 Italian Songs and Arias》第7首；歌词为17世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "3/8",
  "tempo": "行板，哀怨恳求（Andante）",
  "structure": "两段诗节（含 ritornello 间奏）",
  "intro": "斯卡拉蒂 22 岁时为罗马科隆纳家族的私人剧院创作《庞培》（Pompeo，1683），本曲是剧中庞培之子塞斯托（Sesto）的咏叹调：他爱着庞图斯前女王伊西克拉泰娅，但对方对他冷漠，仍盼着回到丈夫与故土。塞斯托唱道：\"哦，请停止伤害我，或者让我去死吧！无情的目光、冷酷无情的，比冰更冷、比大理石更硬，对我的痛苦充耳不闻；比毒蛇更毒、比蝮蛇更狠，对我的叹息残酷而充耳不闻。高傲的眼睛、盲目而残忍，你们本可以治愈我，却以我的憔悴为乐。\"反复的旋律音象征\"迷恋\"，流动的低音传达内心的不安；巴黎奥蒂版删去了引子、间奏与第二段诗节，改动恰恰颠倒了这层象征。",
  "lyrics": [
    {
      "section": "A",
      "it": "O cessate di piagarmi,",
      "zh": "哦，请停止伤害我，",
      "words": [
        { "it": "O", "ipa": "o", "zh": "哦" },
        { "it": "cessate", "ipa": "tʃesˈsaː.te", "zh": "停止（cessare 命令式）" },
        { "it": "di", "ipa": "di", "zh": "（介词）" },
        { "it": "piagarmi", "ipa": "pjaˈɡar.mi", "zh": "伤害我（piagare+mi）" }
      ],
      "notes": "cessate 双 s [ss] 延长、e 闭口 [e]；句首 O 闭口 [o]，如叹息。"
    },
    {
      "section": "A",
      "it": "O lasciatemi morir!",
      "zh": "或者让我去死吧！",
      "words": [
        { "it": "O", "ipa": "o", "zh": "或者" },
        { "it": "lasciatemi", "ipa": "laʃˈʃaː.te.mi", "zh": "让我（lasciare 命令式+mi）" },
        { "it": "morir", "ipa": "moˈrir", "zh": "去死（morire 的缩略）" }
      ],
      "notes": "lasciatemi 的 sc 读 [ʃ] 且延长 [ʃʃ]；morir 重音词尾。"
    },
    {
      "section": "A",
      "it": "Luci ingrate,",
      "zh": "无情的目光，",
      "words": [
        { "it": "Luci", "ipa": "ˈluː.tʃi", "zh": "眼睛、目光（诗语）" },
        { "it": "ingrate", "ipa": "inˈɡraː.te", "zh": "无情的" }
      ],
      "notes": "luci 的 c 在 i 前读 [tʃ]。"
    },
    {
      "section": "A",
      "it": "Dispietate,",
      "zh": "冷酷无情的，",
      "words": [
        { "it": "Dispietate", "ipa": "dispjeˈtaː.te", "zh": "冷酷的（诗语）" }
      ],
      "notes": "Dispietate 的 s 在元音前读清音 [s]（dis- 前缀惯例）；pietà 双元音 [pje]。"
    },
    {
      "section": "B",
      "it": "Più di gelo e più de' marmi",
      "zh": "比冰更冷、比大理石更硬",
      "words": [
        { "it": "Più", "ipa": "pju", "zh": "更" },
        { "it": "di", "ipa": "di", "zh": "比" },
        { "it": "gelo", "ipa": "ˈdʒɛː.lo", "zh": "冰" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "più", "ipa": "pju", "zh": "更" },
        { "it": "de'", "ipa": "de", "zh": "比（dei 的省略）" },
        { "it": "marmi", "ipa": "ˈmar.mi", "zh": "大理石" }
      ],
      "notes": "gelo 的 e 开口 [ɛ]；de' 的 e 闭口 [e]。"
    },
    {
      "section": "B",
      "it": "Fredde e sorde a miei martir!",
      "zh": "对我的痛苦冷漠而充耳不闻！",
      "words": [
        { "it": "Fredde", "ipa": "ˈfred.de", "zh": "冷漠的" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "sorde", "ipa": "ˈsor.de", "zh": "充耳不闻的" },
        { "it": "a", "ipa": "a", "zh": "对" },
        { "it": "miei", "ipa": "ˈmjɛi", "zh": "我的" },
        { "it": "martir", "ipa": "marˈtir", "zh": "痛苦（martire 的缩略）" }
      ],
      "notes": "Fredde 双 d [dd]；miei 的 e 开口 [ɛ]；martir 重音词尾。"
    },
    {
      "section": "C",
      "it": "Più d'un angue, più d'un aspe,",
      "zh": "比毒蛇更毒、比蝮蛇更狠，",
      "words": [
        { "it": "Più", "ipa": "pju", "zh": "更" },
        { "it": "d'un", "ipa": "dun", "zh": "比一（di+un）" },
        { "it": "angue", "ipa": "ˈaŋ.ɡwe", "zh": "蛇（诗语）" },
        { "it": "più", "ipa": "pju", "zh": "更" },
        { "it": "d'un", "ipa": "dun", "zh": "比一" },
        { "it": "aspe", "ipa": "ˈas.pe", "zh": "蝮蛇（诗语）" }
      ],
      "notes": "angue 的 ng 读 [ŋɡ]；aspe 的 s 在辅音前读 [s]。"
    },
    {
      "section": "C",
      "it": "Crudi e sordi a' miei sospir,",
      "zh": "对我的叹息残酷而充耳不闻，",
      "words": [
        { "it": "Crudi", "ipa": "ˈkruː.di", "zh": "残酷的" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "sordi", "ipa": "ˈsor.di", "zh": "充耳不闻的" },
        { "it": "a'", "ipa": "a", "zh": "对" },
        { "it": "miei", "ipa": "ˈmjɛi", "zh": "我的" },
        { "it": "sospir", "ipa": "soˈspir", "zh": "叹息（sospiro 的缩略）" }
      ],
      "notes": "sospir 重音词尾；sorde/sordi 的 o 闭口 [o]。"
    },
    {
      "section": "C",
      "it": "Occhi alteri,",
      "zh": "高傲的眼睛，",
      "words": [
        { "it": "Occhi", "ipa": "ˈɔk.ki", "zh": "眼睛" },
        { "it": "alteri", "ipa": "alˈtɛː.ri", "zh": "高傲的" }
      ],
      "notes": "Occhi 的 o 开口 [ɔ]、双 c [kk]；alteri 的 e 开口 [ɛ]。"
    },
    {
      "section": "C",
      "it": "Ciechi e fieri,",
      "zh": "盲目而残忍，",
      "words": [
        { "it": "Ciechi", "ipa": "ˈtʃɛː.ki", "zh": "盲目的" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "fieri", "ipa": "ˈfjɛː.ri", "zh": "残忍的" }
      ],
      "notes": "Ciechi 与 fieri 的 e 都开口 [ɛ]；ciechi 的 c 在 i 前读 [tʃ]。"
    },
    {
      "section": "D",
      "it": "Voi potete risanarmi,",
      "zh": "你们本可以治愈我，",
      "words": [
        { "it": "Voi", "ipa": "vɔi", "zh": "你们" },
        { "it": "potete", "ipa": "poˈteː.te", "zh": "可以（potere 第二人称复数）" },
        { "it": "risanarmi", "ipa": "rizaˈnar.mi", "zh": "治愈我" }
      ],
      "notes": "Voi 的 o 开口 [ɔ]；risanarmi 的 s 在元音间读浊音 [z]。"
    },
    {
      "section": "D",
      "it": "E godete al mio languir.",
      "zh": "却以我的憔悴为乐。",
      "words": [
        { "it": "E", "ipa": "e", "zh": "却" },
        { "it": "godete", "ipa": "ɡoˈdeː.te", "zh": "你们享受" },
        { "it": "al", "ipa": "al", "zh": "以（a+il）" },
        { "it": "mio", "ipa": "ˈmiː.o", "zh": "我的" },
        { "it": "languir", "ipa": "laŋˈɡwir", "zh": "憔悴（languire 的缩略）" }
      ],
      "notes": "godete 的 o 闭口 [o]；languir 重音词尾，r 颤音收尾。"
    }
  ],
  "diction_notes": [
    "双辅音：cessate [ss]、lasciatemi [ʃʃ]、Fredde [dd]、Occhi [kk]。",
    "开闭口对比是本曲表情关键：开口 [ɛ]（gelo、miei、alteri、Ciechi、fieri）表示\"冷\"与\"傲\"，闭口 [o]/[e]（sorde、godete、cessate）表示\"麻木\"与\"享受\"。",
    "诗语缩略词密集：morir、martir、sospir、languir、angue、aspe——重音都在词尾。",
    "反复出现的旋律音象征\"迷恋\"（sospiro 动机），演唱时要让元音色彩统一、重复音不呆板。",
    "occhi 的开口 [ɔ]+[kk] 与 luci 的 [u]+[tʃ] 是两组\"眼睛\"的说法，色彩一冷一热，注意区分。",
    "巴黎奥蒂版删了第二段诗节（本曲 C/D 段），本谱按斯卡拉蒂原貌演唱两段。"
  ],
  "practice_tips": [
    "A 段（请求）与 C 段（控诉）语气相反：A 段 mp 哀求，C 段渐强愤怒，最后 D 段回到苦涩的嘲讽。",
    "双辅音串（cessate/lasciatemi/Fredde/Occhi）先用节拍器打满时值。",
    "angue/aspe 两个古词单独练发音（[ŋɡwe]/[aspe]），避免唱成英语。",
    "全曲 3/8 拍，流动而不急促；反复音动机要唱出\"痴迷\"的执着感。"
  ]
}
