{
  "id": "o-del-mio-dolce-ardor",
  "number": 22,
  "title": {
    "it": "O del mio dolce ardor",
    "zh": "哦我甜蜜的热情"
  },
  "composer": {
    "name": "Christoph Willibald von Gluck",
    "life": "1714–1787"
  },
  "source": "出自歌剧《Paride ed Elena》（维也纳，1770）第一幕；《26 Italian Songs and Arias》第22首；歌词为18世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "C（原谱 G 小调，男高音/男声+双簧管独奏+弦乐）",
  "tempo": "中板（Moderato）",
  "structure": "通谱（两段，句尾呼唤）",
  "intro": "格鲁克（Gluck）是歌剧改革者，主张情感的直接与朴素。歌剧《帕里斯与海伦》写特洛伊王子帕里斯奉爱神阿佛洛狄忒之命前往斯巴达，在能看到斯巴达的海滩上满心喜悦地想象梦中的女子。本曲即帕里斯的咏叹调：\"哦我甜蜜热情的渴望对象！你呼吸的空气，我终于也呼吸到了。无论我的目光转向何处，爱神都为我描绘你可爱的身影；我的思绪便想象出最欢快的希望。而在这充满我胸膛的渴望中，我寻觅你、呼唤你、希望并叹息！\"注意：小调在此象征激情而非悲伤；巴黎奥蒂版标节拍器 46 过慢且误导演唱者把此曲唱得哀伤拖沓，本谱按原意 Moderato。",
  "lyrics": [
    {
      "section": "A",
      "it": "O del mio dolce ardor bramato oggetto!",
      "zh": "哦我甜蜜热情的渴望对象！",
      "words": [
        { "it": "O", "ipa": "o", "zh": "哦" },
        { "it": "del", "ipa": "del", "zh": "……的" },
        { "it": "mio", "ipa": "ˈmiː.o", "zh": "我的" },
        { "it": "dolce", "ipa": "ˈdol.tʃe", "zh": "甜蜜的" },
        { "it": "ardor", "ipa": "arˈdor", "zh": "热情（ardore 的缩略）" },
        { "it": "bramato", "ipa": "braˈmaː.to", "zh": "渴望的" },
        { "it": "oggetto", "ipa": "odˈdʒɛt.to", "zh": "对象" }
      ],
      "notes": "dolce 的 o 闭口 [o]；ardor 重音词尾；oggetto 双 g [ddʒ]、双 t [tt]、e 开口 [ɛ]。"
    },
    {
      "section": "A",
      "it": "L'aure che tu respiri alfin respiro.",
      "zh": "你呼吸的空气，我终于也呼吸到了。",
      "words": [
        { "it": "L'aure", "ipa": "ˈlaw.re", "zh": "空气、微风（aura 复数）" },
        { "it": "che", "ipa": "ke", "zh": "（关系代词）" },
        { "it": "tu", "ipa": "tu", "zh": "你" },
        { "it": "respiri", "ipa": "resˈpiː.ri", "zh": "呼吸（第二人称）" },
        { "it": "alfin", "ipa": "alˈfin", "zh": "终于（alla fine 的缩略）" },
        { "it": "respiro", "ipa": "resˈpiː.ro", "zh": "我呼吸" }
      ],
      "notes": "alfin 重音词尾；L'aure 的 au 读 [aw] 双元音。"
    },
    {
      "section": "A",
      "it": "Ovunque il guardo io giro",
      "zh": "无论我的目光转向何处",
      "words": [
        { "it": "Ovunque", "ipa": "oˈvun.kwe", "zh": "无论何处" },
        { "it": "il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "guardo", "ipa": "ˈɡwar.do", "zh": "目光" },
        { "it": "io", "ipa": "ˈiː.o", "zh": "我" },
        { "it": "giro", "ipa": "ˈdʒiː.ro", "zh": "转动" }
      ],
      "notes": "Ovunque 重音在 -vun-；giro 的 g 在 i 前读 [dʒ]。"
    },
    {
      "section": "A",
      "it": "Le tue vaghe sembianze",
      "zh": "你可爱的身影",
      "words": [
        { "it": "Le", "ipa": "le", "zh": "（定冠词复数）" },
        { "it": "tue", "ipa": "ˈtuː.e", "zh": "你的" },
        { "it": "vaghe", "ipa": "ˈvaː.ɡe", "zh": "可爱的" },
        { "it": "sembianze", "ipa": "semˈbjan.tse", "zh": "身影" }
      ],
      "notes": "sembianze 的 z 读 [ts]。"
    },
    {
      "section": "A",
      "it": "Amore in me dipinge,",
      "zh": "爱神都为我描绘，",
      "words": [
        { "it": "Amore", "ipa": "aˈmoː.re", "zh": "爱神" },
        { "it": "in", "ipa": "in", "zh": "在……中" },
        { "it": "me", "ipa": "me", "zh": "我" },
        { "it": "dipinge", "ipa": "diˈpin.dʒe", "zh": "描绘" }
      ],
      "notes": "Amore 的 o 闭口 [o]；dipinge 的 g 在 e 前读 [dʒ]。"
    },
    {
      "section": "A",
      "it": "Il mio pensier si finge",
      "zh": "我的思绪便想象出",
      "words": [
        { "it": "Il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "mio", "ipa": "ˈmiː.o", "zh": "我的" },
        { "it": "pensier", "ipa": "penˈsjɛr", "zh": "思绪（pensiero 的缩略）" },
        { "it": "si", "ipa": "si", "zh": "自己" },
        { "it": "finge", "ipa": "ˈfin.dʒe", "zh": "想象（fingersi 反身）" }
      ],
      "notes": "pensier 的 e 开口 [ɛ]、重音词尾。"
    },
    {
      "section": "A",
      "it": "Le più liete speranze,",
      "zh": "最欢快的希望，",
      "words": [
        { "it": "Le", "ipa": "le", "zh": "（定冠词）" },
        { "it": "più", "ipa": "pju", "zh": "最" },
        { "it": "liete", "ipa": "ˈljɛː.te", "zh": "欢快的" },
        { "it": "speranze", "ipa": "speˈran.tse", "zh": "希望" }
      ],
      "notes": "liete 的 e 开口 [ɛ]；speranze 的 z 读 [ts]。"
    },
    {
      "section": "B",
      "it": "E nel desio che così m'empie il petto",
      "zh": "而在这充满我胸膛的渴望中",
      "words": [
        { "it": "E", "ipa": "e", "zh": "而" },
        { "it": "nel", "ipa": "nel", "zh": "在……中" },
        { "it": "desio", "ipa": "deˈziː.o", "zh": "渴望（desiderio 的诗语）" },
        { "it": "che", "ipa": "ke", "zh": "（关系代词）" },
        { "it": "così", "ipa": "koˈzi", "zh": "如此" },
        { "it": "m'empie", "ipa": "ˈmɛm.pje", "zh": "充满我（empire 第三人称）" },
        { "it": "il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "petto", "ipa": "ˈpɛt.to", "zh": "胸膛" }
      ],
      "notes": "desio 的 s 浊音 [z]；m'empie 的 e 开口 [ɛ]；petto 双 t [tt]。"
    },
    {
      "section": "B",
      "it": "Cerco te, chiamo te, spero e sospiro!",
      "zh": "我寻觅你、呼唤你、希望并叹息！",
      "words": [
        { "it": "Cerco", "ipa": "ˈtʃer.ko", "zh": "我寻觅" },
        { "it": "te", "ipa": "te", "zh": "你" },
        { "it": "chiamo", "ipa": "ˈkjaː.mo", "zh": "我呼唤" },
        { "it": "te", "ipa": "te", "zh": "你" },
        { "it": "spero", "ipa": "ˈspeː.ro", "zh": "我希望" },
        { "it": "e", "ipa": "e", "zh": "和" },
        { "it": "sospiro", "ipa": "soˈspiː.ro", "zh": "我叹息" }
      ],
      "notes": "Cerco 的 c 在 e 前读 [tʃ]；sospiro 重音在 -spi-。"
    }
  ],
  "diction_notes": [
    "本曲是男声抒情咏叹调的经典：开闭口 e 密集（oggetto [ɛ]、m'empie [ɛ]、liete [ɛ]、petto [ɛ]、pensier [ɛ]），与闭口 o（dolce、Amore、ardor）交替。",
    "双辅音/塞擦音：oggetto [ddʒ]+[tt]、petto [tt]。",
    "诗语缩略：ardor、alfin、pensier、desio——重音词尾。",
    "重要：小调在此象征激情而非悲伤——全曲要唱出热切期待，不是哀伤。",
    "原谱 G 小调 C 拍；巴黎奥蒂版节拍器 46 过慢且漏印部分原音符，勿被误导。",
    "第 4、34 小节的倚音为格鲁克亲笔，其余装饰音为编者添加，可酌情取舍。"
  ],
  "practice_tips": [
    "句尾三连呼唤（Cerco te, chiamo te…）是全曲情感顶点，层层推进不提前释放。",
    "长乐句（Ovunque il guardo…）规划气口，保持 legato 线条。",
    "开闭口 e 词（oggetto/petto/m'empie）唱高音时保持开口音色不扁。",
    "本曲速度 Moderato：按\"行走\"般从容，不要按奥蒂版拖成 46 的慢速。"
  ]
}
