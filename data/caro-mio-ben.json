{
  "id": "caro-mio-ben",
  "number": 23,
  "title": {
    "it": "Caro mio ben",
    "zh": "我亲爱的"
  },
  "composer": {
    "name": "Tommaso Giordani",
    "life": "1730–1806"
  },
  "source": "《26 Italian Songs and Arias》第23首；歌词为18世纪公有领域文本",
  "voice": "Medium Low",
  "meter": "3/4",
  "tempo": "Larghetto",
  "structure": "A1–B–B'–A2（A2 为 da capo 再现）",
  "intro": "这是声乐学习中传唱度最高的意大利歌曲之一。曲调出自意大利作曲家托马索·焦尔达尼（Tommaso Giordani），1782年前后作于伦敦，由男高音 Tenducci 在潘西翁音乐厅演唱后风靡。歌词是诗化的古意大利语，以恋人恳求的口吻写成：你不在身边，我的心便枯萎；我始终忠诚，只求你收起冷酷。词中大量使用省略形式（ben、almen、cor、fedel、ognor、rigor），是学习意大利语诗歌缩略与元音开闭口的最佳入门曲。",
  "lyrics": [
    {
      "section": "A1",
      "it": "Caro mio ben,",
      "zh": "我亲爱的，",
      "words": [
        { "it": "Caro", "ipa": "ˈkaː.ro", "zh": "亲爱的" },
        { "it": "mio", "ipa": "ˈmiː.o", "zh": "我的" },
        { "it": "ben", "ipa": "bɛn", "zh": "心爱之人（bene 的缩略）" }
      ],
      "notes": "Caro 的 a 为开口长元音，保持饱满不变形；mio 的 i-o 是两个独立音节，勿滑成 [jo]。"
    },
    {
      "section": "A1",
      "it": "Credimi almen,",
      "zh": "至少相信我，",
      "words": [
        { "it": "Credimi", "ipa": "ˈkrɛː.di.mi", "zh": "相信我（credere 命令式+mi）" },
        { "it": "almen", "ipa": "alˈmɛn", "zh": "至少（almeno 的缩略）" }
      ],
      "notes": "Credimi 的 e 为开口 [ɛ]；r 是单颤音，舌尖轻弹一次。almen 的 e 同样开口。"
    },
    {
      "section": "A1",
      "it": "Senza di te",
      "zh": "没有你",
      "words": [
        { "it": "Senza", "ipa": "ˈsɛn.tsa", "zh": "没有" },
        { "it": "di", "ipa": "di", "zh": "（前置词）" },
        { "it": "te", "ipa": "te", "zh": "你" }
      ],
      "notes": "Senza 的 z 发清音 [ts]（如英语 cats 的 ts）；e 为开口 [ɛ]。te 的 e 为闭口 [e]，重读。"
    },
    {
      "section": "A1",
      "it": "Languisce il cor.",
      "zh": "我的心在枯萎。",
      "words": [
        { "it": "Languisce", "ipa": "laŋˈɡwiʃ.ʃe", "zh": "枯萎、憔悴（languire 第三人称）" },
        { "it": "il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "cor", "ipa": "kor", "zh": "心（cuore 的诗语缩略）" }
      ],
      "notes": "Languisce：sc 在 i/e 前读 [ʃ]（sh 音），连写时延长为 [ʃʃ]；gu 读 [ɡw]，重音在 gui。cor 的 o 为闭口 [o]。"
    },
    {
      "section": "B",
      "it": "Il tuo fedel",
      "zh": "你忠诚的人，",
      "words": [
        { "it": "Il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "tuo", "ipa": "ˈtuː.o", "zh": "你的" },
        { "it": "fedel", "ipa": "feˈdel", "zh": "忠诚的人（fedele 的缩略）" }
      ],
      "notes": "tuo 同样两音节分明：/tuː.o/。fedel 的 e 为闭口 [e]（注意：crudele 开口、fedele 闭口，是经典易混对），重音在词尾 del。"
    },
    {
      "section": "B",
      "it": "Sospira ognor.",
      "zh": "时刻叹息。",
      "words": [
        { "it": "Sospira", "ipa": "soˈspiː.ra", "zh": "叹息（sospirare 第三人称）" },
        { "it": "ognor", "ipa": "oɲˈɲor", "zh": "总是（ognora 的缩略）" }
      ],
      "notes": "Sospira 的两个 o 均为闭口 [o]；s 在 p 前读清音 [s]。ognor 的 gn 读 [ɲ]（如汉语拼音 ni 的鼻腭音），双写延长 [ɲɲ]。"
    },
    {
      "section": "B",
      "it": "Cessa, crudel,",
      "zh": "停下吧，狠心的人，",
      "words": [
        { "it": "Cessa", "ipa": "ˈtʃes.sa", "zh": "停止（cessare 命令式）" },
        { "it": "crudel", "ipa": "kruˈdɛl", "zh": "残酷的人（crudele 的缩略）" }
      ],
      "notes": "Cessa 的双 s 必须真正延长 [ss]，这是意大利语辅音时值的灵魂；e 为闭口 [e]。crudel 的 e 开口 [ɛ]，r 在辅音 c 后仍要发颤音。"
    },
    {
      "section": "B",
      "it": "Tanto rigor!",
      "zh": "如此的冷酷！",
      "words": [
        { "it": "Tanto", "ipa": "ˈtan.to", "zh": "如此多的" },
        { "it": "rigor", "ipa": "riˈɡor", "zh": "冷酷、严厉（rigore 的缩略）" }
      ],
      "notes": "t 为齿音（舌尖抵上齿），不送气；rigor 的 o 闭口 [o]，r 单颤。"
    },
    {
      "section": "B'",
      "it": "Cessa, crudel,",
      "zh": "停下吧，狠心的人，",
      "words": [
        { "it": "Cessa", "ipa": "ˈtʃes.sa", "zh": "停止" },
        { "it": "crudel", "ipa": "kruˈdɛl", "zh": "残酷的人" }
      ],
      "notes": "B' 段是 B 段的情绪强化重复，双辅音与开口 e 的处理同前，但语气更重。"
    },
    {
      "section": "B'",
      "it": "Tanto rigor,",
      "zh": "如此的冷酷，",
      "words": [
        { "it": "Tanto", "ipa": "ˈtan.to", "zh": "如此多的" },
        { "it": "rigor", "ipa": "riˈɡor", "zh": "冷酷" }
      ],
      "notes": ""
    },
    {
      "section": "B'",
      "it": "Tanto rigor!",
      "zh": "如此的冷酷！",
      "words": [
        { "it": "Tanto", "ipa": "ˈtan.to", "zh": "如此多的" },
        { "it": "rigor", "ipa": "riˈɡor", "zh": "冷酷" }
      ],
      "notes": "B' 段以全曲最高音收束，rigor 的闭口 [o] 在高音上要保持圆、立，不散。"
    },
    {
      "section": "A2",
      "it": "Caro mio ben,",
      "zh": "我亲爱的，",
      "words": [
        { "it": "Caro", "ipa": "ˈkaː.ro", "zh": "亲爱的" },
        { "it": "mio", "ipa": "ˈmiː.o", "zh": "我的" },
        { "it": "ben", "ipa": "bɛn", "zh": "心爱之人" }
      ],
      "notes": "A2 为 da capo 再现，唱法同 A1，但可依巴洛克惯例加少量装饰音。"
    },
    {
      "section": "A2",
      "it": "Credimi almen,",
      "zh": "至少相信我，",
      "words": [
        { "it": "Credimi", "ipa": "ˈkrɛː.di.mi", "zh": "相信我" },
        { "it": "almen", "ipa": "alˈmɛn", "zh": "至少" }
      ],
      "notes": ""
    },
    {
      "section": "A2",
      "it": "Senza di te",
      "zh": "没有你",
      "words": [
        { "it": "Senza", "ipa": "ˈsɛn.tsa", "zh": "没有" },
        { "it": "di", "ipa": "di", "zh": "（前置词）" },
        { "it": "te", "ipa": "te", "zh": "你" }
      ],
      "notes": ""
    },
    {
      "section": "A2",
      "it": "Languisce il cor.",
      "zh": "我的心在枯萎。",
      "words": [
        { "it": "Languisce", "ipa": "laŋˈɡwiʃ.ʃe", "zh": "枯萎" },
        { "it": "il", "ipa": "il", "zh": "（定冠词）" },
        { "it": "cor", "ipa": "kor", "zh": "心" }
      ],
      "notes": "全曲终止，Languisce il cor 的 [ʃʃ] 延长与 [kor] 的闭口 [o] 要收得干净。"
    }
  ],
  "diction_notes": [
    "元音开闭口是本曲第一要务：开口 [ɛ]（ben、almen、Credimi、fedel、crudel）与闭口 [e]（te、Cessa）必须严格区分，意大利语唱错开闭口等于拼错单词。",
    "双辅音必须延长：Cessa 的 [ss]、Languisce 的 [ʃʃ]、ognor 的 [ɲɲ]——意大利语辅音时值是节奏的一部分，不能按英语习惯省略。",
    "古语缩略词是重点：ben、almen、cor、fedel、ognor、rigor 分别是 bene、almeno、cuore、fedele、ognora、rigore 的诗语省略，重音都落在词末，唱时勿加重错误音节。注意 fedel 的 e 是闭口 [e]，与 crudele 的开口 [ɛ] 相对。",
    "r 一律发单颤音（舌尖轻弹），包括辅音丛 cr-（crudel）与词中 -r-（Caro、Sospira、rigor），这是意大利语区别于英语 r 的关键。",
    "双元音分唱：mio（i-o）、tuo（u-o）是两个独立元音音节，在巴洛克风格中清晰分开，不滑音。",
    "Senza 的 z 发 [ts]（清音），不是 [dz]；这是意大利语 z 在词首的常见读音规则。"
  ],
  "practice_tips": [
    "先用标准 IPA 逐词慢读（每词 2 拍），再按乐句节奏朗读，最后才上旋律。",
    "全曲音域不大（约一个八度内），适合用作男中音/男低音的暖声与连音（legato）练习曲。",
    "A2 段 da capo 再现时，可在长音上加轻颤音或回音（trillo / gruppo），但装饰要符合 18 世纪风格，宁少勿滥。",
    "听示范音频时，先只跟节奏不跟音高，确认辅音时值；再跟唱旋律。"
  ]
}
